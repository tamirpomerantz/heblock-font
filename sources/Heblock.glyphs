    sub zero by zero.circled;
    sub one by one.circled;
    sub two by two.circled;
    sub three by three.circled;
    sub four by four.circled;
    sub five by five.circled;
    sub six by six.circled;
    sub seven by seven.circled;
    sub eight by eight.circled;
    sub nine by nine.circled;
} ss11_SUB;
@circ_ss11 = [zero.circled one.circled two.circled three.circled four.circled five.circled six.circled seven.circled eight.circled nine.circled];
@start_ss11 = [zero.circled.start one.circled.start two.circled.start three.circled.start four.circled.start five.circled.start six.circled.start seven.circled.start eight.circled.start nine.circled.start];
@mid_ss11 = [zero.circled.middle one.circled.middle two.circled.middle three.circled.middle four.circled.middle five.circled.middle six.circled.middle seven.circled.middle eight.circled.middle nine.circled.middle];
@end_ss11 = [zero.circled.end one.circled.end two.circled.end three.circled.end four.circled.end five.circled.end six.circled.end seven.circled.end eight.circled.end nine.circled.end];
lookup ss11_START {
    ignore sub [@circ_ss11 @start_ss11 @mid_ss11] @circ_ss11';
    sub @circ_ss11' @circ_ss11 by @start_ss11;
} ss11_START;
lookup ss11_END {
    ignore sub @circ_ss11' @circ_ss11;
    sub [@start_ss11 @mid_ss11 @circ_ss11] @circ_ss11' by @end_ss11;
} ss11_END;
lookup ss11_MID {
    sub [@start_ss11 @mid_ss11] @circ_ss11' [@end_ss11 @mid_ss11 @circ_ss11] by @mid_ss11;
} ss11_MID;
";
